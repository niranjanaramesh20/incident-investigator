OPENAI_API_KEY=your-openai-api-key
DATABASE_URL=postgresql+psycopg2://anu:anu123@localhost:5433/incidents
API_ACCESS_TOKEN=
ALLOW_LEGACY_API_TOKEN=false
# Generate a stable random value of at least 32 characters for signed user sessions.
SESSION_SECRET=
# Set these once to create the first administrator with `python -m app.scripts.create_admin`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional outbound assignment and status notifications. Leave blank to disable delivery.
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_SMTP_SSL=false
SLACK_WEBHOOK_URL=
# Optional: defaults to backend/data/chroma_db
# CHROMA_PERSIST_DIRECTORY=/absolute/path/to/chroma_db
